<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 17+: needed to reach a PC on the local network (or the emulator's host). -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- The low-latency Wi-Fi lock while a stream plays. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- The USB protocol; the others work without it. -->
    <uses-feature
        android:name="android.hardware.usb.accessory"
        android:required="false" />

    <application
        android:name=".GazeoraApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Gazeora">

        <!-- singleTop: plugging the phone in again reaches the running one (onNewIntent). -->
        <activity
            android:name=".feature.connect.presentation.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Gazeora.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The PC switched the phone to USB accessory mode: open the stream. -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED"
                android:resource="@xml/accessory_filter" />
        </activity>

        <!-- Landscape for a phone viewer; handles its own config changes so the stream keeps
             playing when the phone turns over. -->
        <activity
            android:name=".feature.player.presentation.PlayerActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />
    </application>

</manifest>
